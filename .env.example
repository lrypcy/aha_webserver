# aha_webserver 环境变量示例
# 用法：cp .env.example .env 后按需修改；docker compose 会自动读取根目录 .env 做变量替换。
# 本项目通过 viper.AutomaticEnv + 前缀 AHA_ 读取环境变量，
# 环境变量优先级高于 configs/config.yml 中的默认值。
#
# 【重要】.env 含密钥，切勿提交到 Git（已在 .gitignore 中忽略）。
# 生产环境必须通过 AHA_JWT_SECRET 显式设置强随机密钥，生成方式：
#   openssl rand -hex 32
# 未设置密钥时服务不应在生产环境启动（生产必填）。
# 下面所有密钥/口令均为占位示例，禁止直接用于生产。

# ---- 服务 ----
AHA_SERVER_PORT=8080
AHA_SERVER_ENV=production

# ---- 数据库 ----
# 本地零配置开发可直接 go run .（默认 sqlite，无需下面这些连接参数）。
# 下面示例对应 docker-compose.yml 中的 postgres:16-alpine 服务；
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD 会预先建好库，
# AHA_DB_NAME 必须指向该库（数据库层不会自动 CREATE DATABASE）。
AHA_DB_TYPE=postgresql
AHA_DB_HOST=postgres
AHA_DB_PORT=5432
AHA_DB_USER=aha
AHA_DB_PASSWORD=please-change-this-password
AHA_DB_NAME=aha

# ---- JWT ----
# 用 openssl rand -hex 32 生成后替换；这里只是占位示例，禁止直接用于生产。
AHA_JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
AHA_JWT_EXPIRATION=24h

# ---- 日志 / 跨域 / 限流 ----
AHA_LOG_LEVEL=info
AHA_CORS_ORIGINS=http://localhost:8080
AHA_RATE_LIMIT_MAX=100
